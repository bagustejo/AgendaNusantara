<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgendaNusantara">

        <!-- Login: launcher entry point -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Beranda -->
        <activity
            android:name=".BerandaActivity"
            android:exported="false" />

        <!-- Tambah Tugas (Penting & Biasa via EXTRA_CATEGORY) -->
        <activity
            android:name=".TambahTugasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Daftar Tugas -->
        <activity
            android:name=".DaftarTugasActivity"
            android:exported="false" />

        <!-- Pengaturan -->
        <activity
            android:name=".PengaturanActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
