<?xml version="1.0" encoding="utf-8"?>
<!--
    Box stroke color for Material TextInputLayout.
    - Focused  → primary teal
    - Default  → light slate border
    - Error    → handled automatically by Material
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/primary"              android:state_focused="true"/>
    <item android:color="@color/input_border_default"/>
</selector>
