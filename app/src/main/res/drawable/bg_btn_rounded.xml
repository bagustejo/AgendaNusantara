<?xml version="1.0" encoding="utf-8"?>
<!--
    Background rounded pill untuk tombol Simpan.
    Warna diset dari Activity via setBackgroundColor(),
    shape ini hanya menyediakan radius.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/color_penting" />
    <corners android:radius="30dp" />
</shape>
